{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug fastbootCmds.exe",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/fastbootCmds.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": true,
      "MIMode": "gdb",
      "miDebuggerPath": "D:/mingw64/bin/gdb.exe",
      "setupCommands": [
        {
          "description": "Enable pretty-printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "build fastbootCmds"
    }
  ]
}
