{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "① 调试源码 · 无参数（打印用法）",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/fastbootCmds_dbg.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "externalConsole": true,
      "MIMode": "gdb",
      "miDebuggerPath": "D:/mingw64/bin/gdb.exe",
      "setupCommands": [
        { "description": "Enable pretty-printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ],
      "preLaunchTask": "build (debug)"
    },
    {
      "name": "② 调试源码 · devices",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/fastbootCmds_dbg.exe",
      "args": ["devices"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "externalConsole": true,
      "MIMode": "gdb",
      "miDebuggerPath": "D:/mingw64/bin/gdb.exe",
      "setupCommands": [
        { "description": "Enable pretty-printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ],
      "preLaunchTask": "build (debug)"
    },
    {
      "name": "③ 调试源码 · 自定义参数（改这里的 args 数组）",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/fastbootCmds_dbg.exe",
      "args": ["getvar", "1", "3"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "externalConsole": true,
      "MIMode": "gdb",
      "miDebuggerPath": "D:/mingw64/bin/gdb.exe",
      "setupCommands": [
        { "description": "Enable pretty-printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ],
      "preLaunchTask": "build (debug)"
    },
    {
      "name": "④ 调试现成的 exe（不重新编译）",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/fastbootCmds.exe",
      "args": ["devices"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "externalConsole": true,
      "MIMode": "gdb",
      "miDebuggerPath": "D:/mingw64/bin/gdb.exe",
      "setupCommands": [
        { "description": "Enable pretty-printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    },
    {
      "name": "⑤ 附加到运行中的 fastbootCmds（界面调起它时用）",
      "type": "cppdbg",
      "request": "attach",
      "program": "${workspaceFolder}/fastbootCmds.exe",
      "processId": "${command:pickProcess}",
      "MIMode": "gdb",
      "miDebuggerPath": "D:/mingw64/bin/gdb.exe",
      "setupCommands": [
        { "description": "Enable pretty-printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    },
    {
      "name": "⑥ 调试调试界面本身（Python）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/fastboot_gui.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    }
  ]
}
